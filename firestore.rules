rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'ffatihanilir@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Profil: yalnızca e-posta, sağlayıcı, platform ve tarihler.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'email', 'provider', 'platform', 'createdAt', 'lastSeenAt',
          'consentVersion', 'consentAt'
        ]);
      allow delete: if isOwner(userId);

      // Her kullanıcı sadece kendi ev kayıtlarına erişir
      match /homes/{homeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Panelde toplam ev sayısı için (collection group sayımı).
    match /{path=**}/homes/{homeId} {
      allow read: if isAdmin();
    }

    // Misafirler de geri bildirim gönderebilir; okuma yalnızca admin.
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasOnly([
          'message', 'category', 'email', 'uid', 'platform', 'status', 'createdAt'
        ])
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3
        && request.resource.data.message.size() <= 2000
        && request.resource.data.category in ['oneri', 'hata', 'soru', 'diger']
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && (request.resource.data.email == null
            || (request.resource.data.email is string
                && request.resource.data.email.size() <= 200))
        && (request.resource.data.uid == null
            || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read, update, delete: if isAdmin();
    }
  }
}
